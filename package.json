		"keybindings": [
			{
				"command": "dbclient.runQuery",
				"key": "f9",
				"when": "editorLangId == sql"
			},
			{
				"command": "dbclient.runQuery",
				"key": "ctrl+enter",
				"when": "editorLangId == sql"
			},
			{
				"command": "dbclient.runAllQuery",
				"key": "ctrl+f9",
				"when": "editorLangId == sql"
			},
			{
				"command": "dbclient.runAllQuery",
				"key": "ctrl+shift+enter",
				"when": "editorLangId == sql"
			},
			{
				"command": "dbclient.mock.run",
				"when": "resourceFilename =~ /mock\\.json$/ ",
				"key": "f9"
			},
			{
				"key": "ctrl+alt+enter",
				"command": "dbclient.runQuery.newTab",
				"when": "editorTextFocus && editorLangId == sql"
			},
			{
				"key": "ctrl+alt+shift+enter",
				"command": "dbclient.runAllQuery.noParse",
				"when": "editorTextFocus && editorLangId == sql"
			},
			{
				"key": "ctrl+alt+c",
				"command": "dbclient.db.active",
				"when": "editorTextFocus && editorLangId == sql"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "dbclient.runQuery",
					"when": "editorLangId == sql",
					"group": "navigation@-2"
				},
				{
					"command": "dbclient.runAllQuery",
					"when": "editorLangId == sql",
					"group": "navigation@1"
				},
				{
					"command": "dbclient.db.active",
					"when": "editorLangId == sql",
					"group": "navigation@2"
				}
			],
			"editor/title": [
				{
					"command": "dbclient.mock.run",
					"when": "resourceFilename =~ /mock.json$/ ",
					"group": "navigation"
				},
				{
					"command": "dbclient.runQuery",
					"when": "editorLangId == sql || resourceFilename =~ /.sql$/ ",
					"group": "navigation"
				}
			],
			"view/title": [
				{
					"command": "dbclient.connection.add",
					"when": "view =~ /dbclient.+?ql/",
					"group": "navigation@3"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/",
					"group": "navigation@2"
				},
				{
					"command": "dbclient.history.open",
					"when": "view == dbclient.view.sql",
					"group": "navigation@0"
				},
				{
					"command": "dbclient.struct.diff",
					"when": "view == dbclient.view.sql",
					"group": "navigation@-2"
				},
				{
					"command": "dbclient.connection.config",
					"when": "view =~ /dbclient.+?ql/",
					"group": "navigation@-3"
				},
				{
					"command": "dbclient.util.github",
					"when": "view == dbclient.view.nosql",
					"group": "navigation@-3"
				}
			],
			"view/item/context": [
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(catalog|esConnection|sshConnection|folder|redisConnection|connection|tableGroup|viewGroup|systemViewGroup|triggerGroup|procedureGroup|functionGroup|table)$/",
					"group": "inline@-2"
				},
				{
					"command": "dbclient.connection.edit",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(connection|esConnection|redisConnection|ftpConnection|s3Connection|sshConnection)$/",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.connection.disable",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(connection|esConnection|redisConnection|ftpConnection|s3Connection)$/",
					"group": "1_mysql@4"
				},
				{
					"command": "dbclient.host.copy",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(connection|esConnection|redisConnection)$/",
					"group": "1_mysql@6"
				},
				{
					"command": "dbclient.database.add",
					"when": "view =~ /dbclient.+?ql/ && viewItem == connection",
					"group": "2_mysql@0"
				},
				{
					"command": "dbclient.query.add",
					"when": "view =~ /dbclient.+?ql/ && viewItem == queryGroup",
					"group": "2_mysql@0"
				},
				{
					"command": "dbclient.query.rename",
					"when": "view =~ /dbclient.+?ql/ && viewItem == query",
					"group": "2_mysql@0"
				},
				{
					"command": "dbclient.query.run",
					"when": "view =~ /dbclient.+?ql/ && viewItem == query",
					"group": "2_mysql@0"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(esConnection|ftpConnection|ftpFolder|s3Connection|s3Bucket|s3Folder)$/",
					"group": "2_mysql@1"
				},
				{
					"command": "dbclient.server.info",
					"when": "view =~ /dbclient.+?ql/ && viewItem == connection",
					"group": "4_mysql@1"
				},
				{
					"command": "dbclient.data.import",
					"when": "view =~ /dbclient.+?ql/ && viewItem == connection",
					"group": "8_mysql@1"
				},
				{
					"command": "dbclient.connection.delete",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(connection|esConnection|redisConnection|ftpConnection|s3Connection|sshConnection)$/",
					"group": "10mysql@2"
				},
				{
					"command": "dbclient.database.add",
					"when": "view =~ /dbclient.+?ql/ && viewItem == connection",
					"group": "inline@0"
				},
				{
					"command": "dbclient.connection.terminal",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(connection|catalog)$/",
					"group": "inline@2"
				},
				{
					"command": "dbclient.query.switch",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(connection|catalog|database|esConnection|esIndex)$/",
					"group": "inline@5"
				},
				{
					"command": "dbclient.query.add",
					"when": "view =~ /dbclient.+?ql/ && viewItem == queryGroup",
					"group": "inline@0"
				},
				{
					"command": "dbclient.query.run",
					"when": "view =~ /dbclient.+?ql/ && viewItem == query",
					"group": "inline@0"
				},
				{
					"command": "dbclient.template.user",
					"when": "view =~ /dbclient.+?ql/ && viewItem == userGroup",
					"group": "1_mysql@1"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem == userGroup",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.template.user",
					"when": "view =~ /dbclient.+?ql/ && viewItem == userGroup",
					"group": "inline"
				},
				{
					"command": "dbclient.change.user",
					"when": "view =~ /dbclient.+?ql/ && viewItem == user",
					"group": "1_mysql@-1"
				},
				{
					"command": "dbclient.user.grant",
					"when": "view =~ /dbclient.+?ql/ && viewItem == user",
					"group": "1_mysql@0"
				},
				{
					"command": "dbclient.delete.user",
					"when": "view =~ /dbclient.+?ql/ && viewItem == user",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.name.copy",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(catalog|user|database|esColumn|column|table|view|esIndex|procedure|function|trigger|mongoTable|redisKey)$/",
					"group": "-1_mysql@-5"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem == database",
					"group": "3_mysql@0"
				},
				{
					"command": "dbclient.db.truncate",
					"when": "view =~ /dbclient.+?ql/ && viewItem == database",
					"group": "4_mysql@4"
				},
				{
					"command": "dbclient.db.drop",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /(database|catalog)/",
					"group": "4_mysql@5"
				},
				{
					"command": "dbclient.data.export",
					"when": "view =~ /dbclient.+?ql/ && viewItem == database",
					"group": "mysql@5"
				},
				{
					"command": "dbclient.struct.export",
					"when": "view =~ /dbclient.+?ql/ && viewItem == database",
					"group": "mysql@6"
				},
				{
					"command": "dbclient.document.generate",
					"when": "view =~ /dbclient.+?ql/ && viewItem == database",
					"group": "mysql@7"
				},
				{
					"command": "dbclient.data.import",
					"when": "view =~ /dbclient.+?ql/ && viewItem == database",
					"group": "mysql@8"
				},
				{
					"command": "dbclient.table.show",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(table|view)$/",
					"group": "inline@3"
				},
				{
					"command": "dbclient.table.design",
					"when": "view =~ /dbclient.+?ql/ && viewItem == table",
					"group": "2_table@1"
				},
				{
					"command": "dbclient.template.sql",
					"when": "view =~ /dbclient.+?ql/ && viewItem == table",
					"group": "inline@5"
				},
				{
					"command": "dbclient.table.source",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(table)$/",
					"group": "2_table@2"
				},
				{
					"command": "dbclient.view.source",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(view)$/",
					"group": "2_table@2"
				},
				{
					"command": "dbclient.column.add",
					"when": "view =~ /dbclient.+?ql/ && viewItem == table",
					"group": "2_table@3"
				},
				{
					"command": "dbclient.mock.table",
					"when": "view =~ /dbclient.+?ql/ && viewItem == table",
					"group": "3_data@1"
				},
				{
					"command": "dbclient.data.export",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(table|view)$/",
					"group": "3_data@2"
				},
				{
					"command": "dbclient.struct.export",
					"when": "view =~ /dbclient.+?ql/ && viewItem =~ /^(table|view)$/",
					"group": "3_data@3"
				},
				{
					"command": "dbclient.table.truncate",
					"when": "view =~ /dbclient.+?ql/ && viewItem == table",
					"group": "2_mysql@1"
				},
				{
					"command": "dbclient.table.drop",
					"when": "view =~ /dbclient.+?ql/ && viewItem == table",
					"group": "2_mysql@2"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem == tableGroup",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.template.table",
					"when": "view =~ /dbclient.+?ql/ && viewItem == tableGroup",
					"group": "inline"
				},
				{
					"command": "dbclient.column.up",
					"when": "view =~ /dbclient.+?ql/ && viewItem == column",
					"group": "inline@0"
				},
				{
					"command": "dbclient.column.down",
					"when": "view =~ /dbclient.+?ql/ && viewItem == column",
					"group": "inline@2"
				},
				{
					"command": "dbclient.column.drop",
					"when": "view =~ /dbclient.+?ql/ && viewItem == column",
					"group": "3_mysql@1"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem == viewGroup",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.template.view",
					"when": "view =~ /dbclient.+?ql/ && viewItem == viewGroup",
					"group": "inline"
				},
				{
					"command": "dbclient.delete.view",
					"when": "view =~ /dbclient.+?ql/ && viewItem == view",
					"group": "1_mysql@1"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem == procedureGroup",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.template.procedure",
					"when": "view =~ /dbclient.+?ql/ && viewItem == procedureGroup",
					"group": "inline"
				},
				{
					"command": "dbclient.delete.procedure",
					"when": "view =~ /dbclient.+?ql/ && viewItem == procedure",
					"group": "2_mysql@1"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem == functionGroup",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.template.function",
					"when": "view =~ /dbclient.+?ql/ && viewItem == functionGroup",
					"group": "inline"
				},
				{
					"command": "dbclient.delete.function",
					"when": "view =~ /dbclient.+?ql/ && viewItem == function",
					"group": "1_mysql@1"
				},
				{
					"command": "dbclient.refresh",
					"when": "view =~ /dbclient.+?ql/ && viewItem == triggerGroup",
					"group": "1_mysql@2"
				},
				{
					"command": "dbclient.template.trigger",
					"when": "view =~ /dbclient.+?ql/ && viewItem == triggerGroup",
					"group": "inline"
				},
				{
					"command": "dbclient.delete.trigger",
					"when": "view =~ /dbclient.+?ql/ && viewItem == trigger",
					"group": "1_mysql@1"
				},
				{
					"command": "dbclient.connection.terminal",
					"when": "view == dbclient.view.nosql && viewItem == redisConnection",
					"group": "inline@1"
				},
				{
					"command": "dbclient.redis.connection.status",
					"when": "view == dbclient.view.nosql && viewItem == redisConnection",
					"group": "connection"
				},
				{
					"command": "dbclient.redis.key.del",
					"when": "view == dbclient.view.nosql && viewItem =~ /^(redisKey|redisFolder)$/",
					"group": "inline"
				},
				{
					"command": "dbclient.connection.delete",
					"when": "view == dbclient.view.nosql && viewItem =~ /(sshConnection|ftpConnection|s3Connection)/",
					"group": "inline@0"
				},
				{
					"command": "dbclient.connection.terminal",
					"when": "view == dbclient.view.nosql && viewItem == sshConnection",
					"group": "inline@1"
				},
				{
					"command": "dbclient.ssh.host.copy",
					"when": "view == dbclient.view.nosql && viewItem =~ /(sshConnection|ftpConnection|s3Connection)/",
					"group": "0_connection@-2"
				},
				{
					"command": "dbclient.ssh.forward.port",
					"when": "view == dbclient.view.nosql && viewItem == sshConnection",
					"group": "1_nosql@0"
				},
				{
					"command": "dbclient.ssh.socks.port",
					"when": "view == dbclient.view.nosql && viewItem == sshConnection",
					"group": "1_nosql@1"
				},
				{
					"command": "dbclient.ssh.file.new",
					"when": "view == dbclient.view.nosql && viewItem =~ /(sshConnection|ftpConnection)/",
					"group": "2_connection@2"
				},
				{
					"command": "dbclient.ssh.folder.new",
					"when": "view == dbclient.view.nosql && viewItem =~ /(sshConnection|ftpConnection)/",
					"group": "2_connection@4"
				},
				{
					"command": "dbclient.ssh.path.copy",
					"when": "view == dbclient.view.nosql && viewItem =~ /(folder|file|link)/",
					"group": "ssh@1"
				},
				{
					"command": "dbclient.ssh.folder.open",
					"when": "view == dbclient.view.nosql && viewItem == folder",
					"group": "ssh@2"
				},
				{
					"command": "dbclient.ssh.file.new",
					"when": "view == dbclient.view.nosql && viewItem =~ /(folder|ftpFolder)/",
					"group": "folder@0"
				},
				{
					"command": "dbclient.ssh.folder.new",
					"when": "view == dbclient.view.nosql && viewItem =~ /(folder|ftpFolder)/",
					"group": "folder@1"
				},
				{
					"command": "dbclient.ssh.file.upload",
					"when": "view == dbclient.view.nosql && viewItem =~ /(folder|ftpFolder)/",
					"group": "inline@-2"
				},
				{
					"command": "dbclient.ssh.file.delete",
					"when": "view == dbclient.view.nosql && viewItem =~ /^(folder|ftpFolder|file|ftpFile|redisFolder)$/",
					"group": "folder@4"
				},
				{
					"command": "dbclient.ssh.file.download",
					"when": "view == dbclient.view.nosql && viewItem =~ /(folder|file|ftpFile)/",
					"group": "file@1"
				},
				{
					"command": "dbclient.ssh.file.download",
					"when": "view == dbclient.view.nosql && viewItem =~ /(file|ftpFile)/",
					"group": "inline@1"
				}
			]
		},
		"configuration": {
			"type": "object",
			"title": "%config.title%",
			"properties": {
				"database-client.binaryPath": {
					"type": "string",
					"default": "",
					"description": "Folder containing external command line tools (mysql, mysqldump, psql, pg_dump, mongo, mongoimport, redis-cli, sqlite3). Binaries here take priority over PATH. This extension never downloads binaries - install them yourself, place them in this folder, then run Database Client: Check External Tools."
				},
				"database-client.defaultSelectLimit": {
					"type": "integer",
					"default": 100,
					"description": "%config.defaultSelectLimit%"
				},
				"database-client.highlightSQLBlock": {
					"type": "boolean",
					"default": false,
					"description": "Highlight SQL Code block."
				},
				"database-client.preferConnectionName": {
					"type": "boolean",
					"default": true,
					"description": "%config.preferConnectionName%"
				},
				"database-client.disableSqlCodeLen": {
					"type": "boolean",
					"default": false,
					"description": "Disable Sql Code lens."
				},
				"database-client.showUser": {
					"type": "boolean",
					"default": false,
					"description": "Show user on tree view."
				},
				"database-client.showView": {
					"type": "boolean",
					"default": true,
					"description": "Show view on tree view."
				},
				"database-client.showQuery": {
					"type": "boolean",
					"default": false,
					"description": "Show query on tree view."
				},
				"database-client.showProcedure": {
					"type": "boolean",
					"default": true,
					"description": "Show procedure on tree view."
				},
				"database-client.showFunction": {
					"type": "boolean",
					"default": true,
					"description": "Show function on tree view."
				},
				"database-client.showTrigger": {
					"type": "boolean",
					"default": false,
					"description": "Show trigger on tree view."
				},
				"database-client.executeCursorSQLByShortcut": {
					"type": "boolean",
					"default": true,
					"description": "Run the statement at the cursor when nothing is selected."
				},
				"database-client.enableFlexibleSQLParser": {
					"type": "boolean",
					"default": true,
					"description": "Split statements by delimiter blocks rather than plain semicolons."
				},
				"database-client.splitEditorWhenQuery": {
					"type": "boolean",
					"default": true,
					"description": "Split the editor when running a query."
				},
				"database-client.openResultsAsVertically": {
					"type": "boolean",
					"default": true,
					"description": "Show query results below the editor instead of beside it."
				},
				"database-client.autoPagingSQL": {
					"type": "boolean",
					"default": true,
					"description": "Append paging clauses to SELECT statements automatically."
				},
				"database-client.autoGetTableCount": {
					"type": "boolean",
					"default": true,
					"description": "Fetch the total row count when viewing table data. May be slow on very large tables."
				},
				"database-client.enableSQLVariable": {
					"type": "boolean",
					"default": true,
					"description": "Enable :name and $name placeholders in SQL."
				}
			}
		}
	},
	"scripts": {
		"dev": "webpack --progress",
		"build": "npm run build:extension && npm run build:webview && npm run preflight",
		"preflight": "node build/preflight.js",
		"build:extension": "node build.js",
		"build:webview": "webpack --config-name webview --mode=production",
		"build:webpack": "webpack --progress --mode=production",
		"lib": "webpack --config webpack.config.lib.js --progress -p",
		"publich": "vsce publish",
		"vscode:prepublish": "npm run build",
		"vscode:uninstall": "node ./out/uninstall.js"
	},
