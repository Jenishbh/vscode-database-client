{
	"name": "vscode-database-client",
	"displayName": "Database Client",
	"description": "Database Client for VS Code - MySQL, PostgreSQL, SQLite, Redis, MongoDB, MSSQL, ElasticSearch, SSH&FTP. Offline-only fork.",
	"version": "1.5.0",
	"license": "MIT",
	"publisher": "dbclient",
	"icon": "resources/logo.png",
	"engines": {
		"vscode": "^1.51.0"
	},
	"categories": [
		"Programming Languages",
		"Keymaps"
	],
	"keywords": [
		"SQL",
		"MySQL",
		"Database",
		"Postgresql",
		"Redis"
	],
	"bugs": {
		"url": "https://github.com/jenishbh/vscode-database-client/issues",
		"email": ""
	},
	"homepage": "https://github.com/jenishbh/vscode-database-client/blob/master/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/jenishbh/vscode-database-client.git"
	},
	"activationEvents": [
		"onCommand:dbclient.connection.add",
		"onCommand:dbclient.refresh",
		"onView:dbclient.view.sql",
		"onView:dbclient.view.nosql"
	],
	"main": "./out/extension",
	"contributes": {
		"languages": [
			{
				"id": "es",
				"aliases": [
					"ElasticSearch",
					"es",
					"elasticsearch"
				],
				"extensions": [
					"es"
				],
				"configuration": "./syntaxes/es.configuration.json"
			},
			{
				"id": "sql",
				"extensions": [
					".sql",
					".dsql"
				],
				"aliases": [
					"SQL"
				],
				"configuration": "./syntaxes/language-configuration.json"
			}
		],
		"snippets": [
			{
				"language": "sql",
				"path": "./syntaxes/snippets.json"
			}
		],
		"grammars": [
			{
				"language": "sql",
				"scopeName": "source.sql",
				"path": "./syntaxes/mysql.tmLanguage.json"
			},
			{
				"language": "es",
				"scopeName": "source.es",
				"path": "./syntaxes/es.tmLanguage.json"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "dbclient-sql",
					"title": "Database",
					"icon": "resources/icon/database-container.svg"
				},
				{
					"id": "dbclient-nosql",
					"title": "NoSQL",
					"icon": "resources/image/other-container.png"
				}
			]
		},
		"views": {
			"dbclient-sql": [
				{
					"id": "dbclient.view.sql",
					"name": "Database"
				}
			],
			"dbclient-nosql": [
				{
					"id": "dbclient.view.nosql",
					"name": "NoSQL"
				}
			]
		},
		"commands": [
			{
				"command": "dbclient.connection.import",
				"title": "Import Connections",
				"category": "Database Client",
				"icon": "$(cloud-download)"
			},
			{
				"command": "dbclient.dependency.check",
				"title": "Check External Tools",
				"category": "Database Client",
				"icon": "$(check-all)"
